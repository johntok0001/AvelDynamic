#!/bin/bash
# Remove an older Avel Dynamic of the same kind so the new one replaces it cleanly.
# $1 is the path of the component package being installed.
if [ "$(basename "$1")" = "AvelDynamic-VST3.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/VST3/Avel Dynamic.vst3"
elif [ "$(basename "$1")" = "AvelDynamic-AU.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/Components/Avel Dynamic.component"
fi
exit 0
